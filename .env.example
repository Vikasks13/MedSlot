# Application
PROJECT_NAME="MedSlot API"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database
# For SQLite (local standalone testing without Docker):
DATABASE_URL="sqlite+aiosqlite:///./medslot.db"
# For PostgreSQL (Docker or production):
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/medslot"

# Security & JWT
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Redis Cache (Optional Bonus)
REDIS_URL="redis://localhost:6379/0"

# Webhook Security
PAYMENT_WEBHOOK_SECRET="whsec_medslot_mock_secret_key"
